{
  "name": "paut-data-manager",
  "productName": "PAUT 데이터 관리",
  "version": "0.2.3",
  "private": true,
  "description": "PAUT NDE 데이터 관리 프로그램 (폐쇄망 단독)",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "electron-vite build && electron . --smoke",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64",
    "dist:mac": "electron-vite build && node scripts/mac-dist.cjs"
  },
  "dependencies": {
    "h5wasm": "^0.10.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
